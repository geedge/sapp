[Unit]
Description=sapp service
After=After=network.target

[Service]
Type=notify
EnvironmentFile=/etc/sysconfig/sapp
WorkingDirectory=${CMAKE_INSTALL_PREFIX}
ExecStart=${CMAKE_INSTALL_PREFIX}/sapp -c ${CMAKE_INSTALL_PREFIX}/etc/sapp.toml -C ${CMAKE_INSTALL_PREFIX} -D ${SAPP_LOG_PATH_VAR}
TimeoutSec=300s
RestartSec=10s
Restart=always
LimitNOFILE=524288
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=processs
WatchdogSec=10s

[Install]
WantedBy=multi-user.target
