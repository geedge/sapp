[Unit]
Description=sapp service
After=After=network.target

[Service]
Type=notify
EnvironmentFile=/etc/sysconfig/sapp
ExecStart=${SAPP_ROOT}/sapp -c ${SAPP_ROOT}/sapp/etc/sapp.toml -D /var/log/sapp
TimeoutSec=300s
RestartSec=10s
Restart=always
LimitNOFILE=524288
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=processs
WatchdogSec=10s

[Install]
WantedBy=multi-user.target
