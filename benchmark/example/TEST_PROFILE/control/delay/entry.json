{	
	"benchmark_pcap_root_dir": "./TEST_PCAP",
	"benchmark_pcap_filename": "test_control_delay.pcap",
	"benchmark_pcap_md5sum": "1294eb5f5aafb6ed7b97b1c80f8033c3",
	
	"_comment_": "注意: 如果不写sapp_config_template, 会使用rpm -i sapp.rpm 首次安装时的默认配置",
	"config_file_template":{
		"_comment1_": "MESA_prof_load_pattern: [section] key=value 形式",
		"MESA_prof_load_pattern": 
		[
			{"file_name":"./etc/sapp.toml",
			 "file_content": 
			    [
					{"section":"packet_io.deployment", "key": "mode", "value": "inline"},
					{"section":"packet_io.internal.interface", "key": "type", "value":"pcap"},
					{"section":"packet_io.internal.interface", "key": "name", "value":"tap0"},
					{"section":"stream.tcp", "key": "syn_mandatory", "value":"0"}
				]
			},
			{"file_name":"etc/gdev.conf",
			 "file_content": 
			    [
					{"section":"Module", "key": "sendto_gdev_ip", "value":"192.168.1.10"}
				]
			},			
			{"file_name":"plug/business/gtest_sapp/gtest_sapp.inf",
			 "file_content": 
			    [
					{"section":"PLUGINFO", "key": "PLUGNAME", "value":"gtest_sapp"},
					{"section":"PLUGINFO", "key": "INIT_FUNC", "value":"SAPP_BENCHMARK_INIT"},
					{"section":"PLUGINFO", "key": "DESTROY_FUNC", "value":"SAPP_BENCHMARK_DESTROY"},					
					{"section":"TCP_ALL", "key": "FUNC_NAME", "value":"PKT_DELAY_ENTRY"},
					{"section":"PLUGINFO", "key": "SO_PATH", "value":".\\x2Fplug\\x2Fbusiness\\x2Fgtest_sapp\\x2Ftest_benchmark_plug.so"}
				]
			}
		],
		
		"_comment2_": "注意raw_pattern不处理特殊格式, 内容要写成一行, 如果需要换行, 自行增加\n符 ",
		"raw_pattern": 
		[
			{"file_name":"plug/conflist.inf",
			 "file_content": "[platform]\n[protocol]\n[business]\n./plug/business/gtest_sapp/gtest_sapp.inf\n"
			}
		]
	},
	"control": {
		"_comment_": "表示在回放第几个包之前先usleep一会, 人为制造超时, 单位:毫秒, 第一个包delay其实没意义",
		"delay": [
			{"pkt_index": 3, "delay_before_replay":5000}
		]
	}
}
