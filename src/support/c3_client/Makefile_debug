CC = g++
CPP = g++

#DATE=$(shell date +%Y-%m-%d_%H:%M:%S)
DATE=$(shell cat version)
CFLAGS = -g -Wall -DPROGRAM_DATE=\"$(DATE)\" -I./include -DNOTIME -DCONTROL_CONVERGE -D_GNU_SOURCE -DLINUX -DLinux -D__LITTLE_ENDIAN_BITFIELD -DVEVIFY_ID_ENABLE -DALWAYS_LOCK  -DPERMORMANCE_DEBUG -DPERFORMANCE_RULE_COUNT=100
#-DDEBUG_STRATEGY 
#-DHASH_MUTEX_ENABLE
LDFLAGS = -rdynamic 
LIBS = -L./ -L./lib/ -L/usr/local/lib/  -lpthread -ldl

#TARGET=libgrule.a
TARGET=c3client
all: $(TARGET)

#debug_client: 

OBJECTS= alloc.o ccchdr.o efd_eventfd.o grule.o c3client.o main.o util.o ruleread.o
$(TARGET): $(OBJECTS)
	#cd route ; make
	ar crsv libgrule.a $^
	$(CPP) $(CFLAGS) $(LDFLAGS) $(LIBS)  -o $@ $^  
#	cp $(TARGET) ../lib/

.c.o:
	$(CC) $(CFLAGS) -c -fPIC $<
.cpp.o:
	$(CPP) $(CFLAGS) -c -fPIC $<
.cc.o:
	$(CPP) $(CFLAGS) -c -fPIC $<


clean:
	rm *.a *.so *.o $(TARGET)  -f



