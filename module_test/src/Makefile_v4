TARGET += gtest_fake_marsio.so

all: $(TARGET)

TARGET_BIN_OBJ=gtest_main.o gtest_sapp_ipv4_bin.o gtest_sapp_ipv6_bin.o gtest_sapp_tcp_bin.o gtest_sapp_udp_bin.o gtest_sapp_comm.o gtest_sapp_support.o gtest_sapp_tunnel.o gtest_sapp_app_state.o
