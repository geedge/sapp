CC	= gcc
CFLAGS	= -g -Wall -fPIC 
CFLAGS  += $(OPTFLAGS)
OBJECTS =  test_kill.o 
MODULES	=  
TARGET	= test_kill.so

INCS	= -I ../../include 


.c.o:  
	$(CC) -c -o $@ $(CFLAGS) -I. $(INCS) $<

.PHONY: all clean 
all: $(TARGET)
$(TARGET):$(OBJECTS)
	$(CC) -o $(TARGET) -shared -fPIC $(CFLAGS) $(OBJECTS) $(MODULES)
	cp $@ ../plug/general
	
test_app.o: test_kill.c

clean:
	rm -f $(TARGET)	$(OBJECTS) 

